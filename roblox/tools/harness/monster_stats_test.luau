local pass, total = 0, 0
local function check(label, ok, detail)
	total += 1
	if ok then pass += 1 end
	print(("[MSTAT] %s %s %s"):format(label, detail or "", ok and "O" or "X"))
end
local ok, err = pcall(function()
	local MS, MD, BR, BD, BS, PD = MODS.MonsterStats, MODS.MonsterData, MODS.BossRules, MODS.BossData, MODS.BalanceSim, MODS.MonsterPrefixData
	local golden = {}
	local n = 0
	for _, line in ipairs(GOLDEN_LINES) do
		local k, v = line:match("^G|([^|]+)|(.+)$")
		if k then golden[k] = v; n += 1 end
	end
	local prefixById = {}
	for _, p in ipairs(PD.prefixes) do prefixById[p.id] = p end
	local bad, cnt, stages = {}, 0, {}
	local function f(v) return ("%.17g"):format(v) end
	for k, want in pairs(golden) do
		local got
		local parts = string.split(k, ".")
		if parts[1] == "trash" and #parts == 4 then
			local t = MD[parts[3]]; local s = tonumber(parts[4]); stages[s] = true
			local st = MS.trash(t, s)
			got = parts[2] == "hp" and st.hp or st.attack
		elseif parts[1] == "trash" and #parts == 5 then
			local t = MD[parts[3]]; local s = tonumber(parts[5])
			got = MS.trash(t, s, prefixById[parts[4]]).hp
		elseif parts[1] == "sim" then
			local s = tonumber(parts[4])
			got = parts[2] == "hp" and BS.getMonsterHp(s, parts[3]) or BS.getMonsterAttack(s, parts[3])
		elseif parts[1] == "boss" then
			local d0 = BR.buildInstanceData(tonumber(parts[5]), parts[3], tonumber(parts[4]))
			got = parts[2] == "hp" and d0.hp or d0.attack
		elseif parts[1] == "tutorial" then
			local d0 = BR.buildTutorialInstanceData(3, tonumber(parts[3]), {}, 0.5, 1.2)
			got = parts[2] == "hp" and d0.hp or d0.attack
		end
		cnt += 1
		if got == nil or f(got) ~= want then
			table.insert(bad, k .. " " .. tostring(got and f(got)) .. " ≠ " .. want)
		end
	end
	local ns = 0
	for _ in pairs(stages) do ns += 1 end
	check(("골든 표 %d값(스테이지 %d지점 · 잡몹 · 시뮬 · 접두사 · 보스 · 견습) 오차 0"):format(cnt, ns), #bad == 0 and cnt >= 1700 and ns >= 30, #bad > 0 and table.concat(bad, " / ", 1, math.min(5, #bad)) or "")
	-- 서버 판정 = 시뮬 = UI: 셋 다 MonsterStats를 부른다(같은 지점 같은 값)
	local same = true
	for _, s in ipairs({ 1, 1000, 10000, 25300 }) do
		for _, key in ipairs(MD.tierOrder) do
			local t = MD[key]
			local server = MS.trashHp(t.hp, s) -- MonsterState.applyDamage 유효 최대 HP(접두사 없음)
			local sim = BS.getMonsterHp(s, key) -- EconSim · BalanceSim
			local ui = MS.trash(t, s).hp -- TargetFocus 대상 줄(MonsterStats.trash)
			same = same and server == sim and sim == ui and MS.trashAttack(t.attack, s) == BS.getMonsterAttack(s, key)
		end
	end
	check("서버 판정 = 시뮬 = 몹 정보 UI(4지점 × 6티어 HP · 공격)", same)
	check("방어 필드 자리 = 0(몹 데이터에 방어 없음 · 피해 식이 아직 안 읽음)", MS.trash(MD.tier1, 100).defense == 0 and MS.defense(nil) == 0)
end)
if not ok then print("[MSTAT] 하네스 에러 " .. tostring(err)) end
print(("[MSTAT] 끝 %d/%d"):format(pass, total))
